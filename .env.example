# Google AI Studio / Gemini API key. Either variable is accepted.
# Keep these server-side; never expose them with a NEXT_PUBLIC_ prefix.
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_API_KEY=

# Defaults to gemini-2.5-flash when omitted.
AI_MODEL_ID=gemini-2.5-flash

# Defaults to web. Set to demo only when you want inference-only research.
RESEARCH_ADAPTER=web

# Local admin cockpit login. Defaults are shown here for the hackathon prototype.
ADMIN_EMAIL=admin@flytbase.com
ADMIN_PASSWORD=flytbdr-admin
ADMIN_SESSION_TOKEN=change-this-for-shared-environments

# Optional Nodemailer SMTP notifications for new contact form submissions.
# Set LEAD_NOTIFICATION_TO to your own inbox.
LEAD_NOTIFICATION_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
