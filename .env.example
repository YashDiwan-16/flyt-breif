# Google AI Studio / Gemini API key. Either variable is accepted.
# Keep these server-side; never expose them with a NEXT_PUBLIC_ prefix.
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_API_KEY=

# Defaults to gemini-2.5-flash when omitted.
AI_MODEL_ID=gemini-2.5-flash

# Defaults to web. Set to demo only when you want inference-only research.
RESEARCH_ADAPTER=web

# MongoDB + Better Auth.
# Local development defaults to mongodb://127.0.0.1:27017/flytbase,
# http://localhost:3001, and a local-only auth secret when these are omitted.
DATABASE_URL=mongodb://127.0.0.1:27017/flytbase
DATABASE_NAME=flytbase
BETTER_AUTH_SECRET=replace-with-a-32-character-minimum-secret
BETTER_AUTH_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3001

# Gmail/Nodemailer lead notifications.
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=465
EMAIL_SERVER_USER=your-gmail-address@gmail.com
EMAIL_SERVER_PASSWORD=your-gmail-app-password
EMAIL_ADMIN=your-admin-inbox@gmail.com
